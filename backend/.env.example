# Server Port (Render sets this automatically)
PORT=5000

# MongoDB Connection String (MongoDB Atlas M0 Free Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/repox?retryWrites=true&w=majority

# Upstash Redis Connection String (Upstash Serverless Free Redis with TLS)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# GitHub Personal Access Token (classic or fine-grained with repo read/write access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# AI LLM Provider Keys (Groq or Gemini)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional) Google Gemini API Key fallback
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# Frontend URL for CORS (e.g. your Vercel deployment URL)
CLIENT_URL=https://your-repox-app.vercel.app

# Set to "true" only if running worker as a separate background process
SEPARATE_WORKER=false
